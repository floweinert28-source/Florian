{
  "name": "journalyst-motion",
  "private": true,
  "version": "0.1.0",
  "description": "Motion-Video zum Journalyst-Dashboard (Remotion)",
  "scripts": {
    "fonts": "bash scripts/fonts.sh",
    "capture": "NODE_PATH=$(npm root -g) node scripts/capture.cjs",
    "stills": "node scripts/stills.mjs",
    "studio": "remotion studio",
    "render": "remotion render Journalyst out/journalyst.mp4",
    "render:vertical": "remotion render JournalystVertical out/journalyst-vertical.mp4",
    "sound2": "python3 scripts/sound2.py",
    "render2": "remotion render Journalyst2 out/journalyst-2.mp4",
    "render2:vertical": "remotion render Journalyst2Vertical out/journalyst-2-vertical.mp4",
    "sound3": "python3 scripts/sound3.py",
    "render3": "remotion render Journalyst3 out/journalyst-3.mp4",
    "render3:vertical": "remotion render Journalyst3Vertical out/journalyst-3-vertical.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "^4.0.534",
    "@remotion/layout-utils": "4.0.534",
    "@remotion/paths": "4.0.534",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.0"
  }
}
