{
  "name": "journalyst-motion",
  "private": true,
  "version": "0.1.0",
  "description": "Motion-Video zum Journalyst-Dashboard (Remotion)",
  "scripts": {
    "fonts": "bash scripts/fonts.sh",
    "capture": "NODE_PATH=$(npm root -g) node scripts/capture.cjs",
    "studio": "remotion studio",
    "render": "remotion render Journalyst out/journalyst-en.mp4",
    "render:de": "remotion render Journalyst out/journalyst-de.mp4 --props='{\"lang\":\"de\"}'"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "^4.0.534",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.0"
  }
}
