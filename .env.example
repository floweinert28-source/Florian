# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
# NIEMALS committen - .env steht in .gitignore
DISCORD_TOKEN=dein-bot-token-hier

# Optional: Server-ID ("Guild"). Wenn gesetzt, werden die Slash-Commands
# sofort nur auf diesem Server registriert (ideal zum Entwickeln).
# Leer lassen => globale Registrierung (kann bis zu 1 Stunde dauern).
GUILD_ID=

# Optional: Pfad zur SQLite-Datenbank (Default: data/tasks.db)
DATABASE_PATH=data/tasks.db

# Optional: Erinnerungen fuer ueberfaellige Aufgaben (true/false, Default: true)
TASK_REMINDERS=true

# Optional: Wie oft auf ueberfaellige Aufgaben geprueft wird (Minuten, Default: 5)
REMINDER_INTERVAL_MINUTES=5

# Optional: Zeitzone fuer Anzeige und relative Angaben (Default: Europe/Berlin)
TIMEZONE=Europe/Berlin

# ---------------------------------------------------------------------------
# Prop-Firm-Trading-Bot (propbot). Alle Werte sind optional - ohne sie gilt das
# 50k-Konto aus der Standardkonfiguration (+4.000 $ Ziel, 2.000 $ Drawdown).
# ---------------------------------------------------------------------------

# Instrument, Zeitrahmen und Strategie
PROPBOT_SYMBOL=EURUSD
PROPBOT_TIMEFRAME=M15
PROPBOT_STRATEGY=trend_pullback
PROPBOT_ADAPTIVE=true

# Kontoregeln der Prop-Firma
PROPBOT_RULES_START_BALANCE=50000
PROPBOT_RULES_PROFIT_TARGET=4000
PROPBOT_RULES_MAX_DRAWDOWN=2000
PROPBOT_RULES_DAILY_LOSS_LIMIT=1000
# static | trailing_intraday | trailing_eod
PROPBOT_RULES_DRAWDOWN_MODE=trailing_eod

# Risiko je Trade (0.005 = 0,5 % = 250 $ auf einem 50k-Konto)
PROPBOT_RISK_BASE_RISK_PCT=0.005
PROPBOT_RISK_MAX_TRADES_PER_DAY=3

# Ablageorte
PROPBOT_JOURNAL=data/journal.db
PROPBOT_STATE=data/live_state.json

# Echter Handel muss bewusst eingeschaltet werden - Standard ist Dry-Run.
PROPBOT_DRY_RUN=true
